{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/action:rest(.*)",
      "destination": "https://www.silwer.sk/action:rest",
      "permanent": false
    },
    {
      "source": "/kosik:rest(.*)",
      "destination": "https://www.silwer.sk/kosik:rest",
      "permanent": false
    },
    {
      "source": "/objednavka:rest(.*)",
      "destination": "https://www.silwer.sk/objednavka:rest",
      "permanent": false
    },
    {
      "source": "/login:rest(.*)",
      "destination": "https://www.silwer.sk/login:rest",
      "permanent": false
    },
    {
      "source": "/registracia:rest(.*)",
      "destination": "https://www.silwer.sk/registracia:rest",
      "permanent": false
    },
    {
      "source": "/klient:rest(.*)",
      "destination": "https://www.silwer.sk/klient:rest",
      "permanent": false
    },
    {
      "source": "/affiliate:rest(.*)",
      "destination": "https://www.silwer.sk/affiliate:rest",
      "permanent": false
    },
    {
      "source": "/:target([^/]+:.*)",
      "destination": "https://www.silwer.sk/:target",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/user/:path(.*)",
      "destination": "https://www.silwer.sk/user/:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
